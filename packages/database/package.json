{
  "name": "@boss/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:validate": "dotenv -e ../../.env -- prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0",
    "dotenv-cli": "^8.0.0"
  }
}
