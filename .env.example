# Runtime
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:3000

# Storefront: leave blank for same-origin deployments. Vite development proxies /api to API_PORT.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
VITE_SITE_ORIGIN=http://localhost:5173

# PostgreSQL (use a least-privileged application account outside local development)
DATABASE_URL=postgresql://boss:boss@localhost:5432/boss?schema=public

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-32-byte-minimum-secret
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=boss_session

# Media storage (provider selected at deployment; do not expose server credentials)
STORAGE_PROVIDER=s3
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

# Payments (not used in Phase 0)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
