{
  "name": "boss-website",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation workspace for a premium pop-culture collectibles platform.",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:database && npm run build:contracts && npm run build:api && npm run build:web",
    "build:database": "npm run build --workspace=@boss/database",
    "build:contracts": "npm run build --workspace=@boss/contracts",
    "build:api": "npm run build --workspace=@boss/api",
    "build:web": "npm run build --workspace=@boss/web",
    "dev:api": "npm run dev --workspace=@boss/api",
    "dev:web": "npm run dev --workspace=@boss/web",
    "start:api": "npm run start --workspace=@boss/api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run lint",
    "db:generate": "npm run db:generate --workspace=@boss/database",
    "db:validate": "npm run db:validate --workspace=@boss/database",
    "db:migrate": "npm run db:migrate --workspace=@boss/database",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@boss/database",
    "db:status": "npm run db:status --workspace=@boss/database",
    "db:reset": "npm run db:reset --workspace=@boss/database",
    "db:seed": "npm run db:seed --workspace=@boss/database"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  }
}
